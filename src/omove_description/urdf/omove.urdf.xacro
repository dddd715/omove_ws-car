<?xml version="1.0"?>
<robot name="omove" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_file" default="$(find omove_description)/config/mecanum_controllers.yaml"/>
  <xacro:arg name="wheel_control_mode" default="velocity"/>


  <!-- ============ 物理参数 ============ -->
  <xacro:property name="body_len" value="0.52"/>
  <xacro:property name="body_wid" value="0.36"/>
  <xacro:property name="body_hgt" value="0.05"/>
  <xacro:property name="wheel_r"  value="0.076"/>
  <xacro:property name="wheel_w"  value="0.04"/>
  <xacro:property name="wheel_base_x" value="0.18"/>
  <xacro:property name="wheel_track_y" value="0.20"/>
  <xacro:property name="chassis_z" value="0.11"/>

  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>


  <!-- base_footprint（Nav2要求的地面投影坐标系） -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============ base_link 底盘 ============ -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_len} ${body_wid} ${body_hgt}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="${body_len} ${body_wid} ${body_hgt}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.2"/>
    </inertial>
  </link>

  <!-- Passive 45-degree rollers: handedness matches the X-layout kinematics. -->
  <xacro:macro name="roller" params="prefix index handedness">
    <xacro:property name="theta" value="${2*pi*index/12}"/>
    <joint name="${prefix}_roller_${index}_joint" type="continuous">
      <parent link="${prefix}_wheel"/>
      <child link="${prefix}_roller_${index}"/>
      <origin xyz="${0.061*cos(theta)} ${0.061*sin(theta)} 0"
              rpy="0 ${pi/4 if handedness > 0 else 3*pi/4} ${theta+pi/2}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.00001" friction="0.0"/>
    </joint>
    <link name="${prefix}_roller_${index}">
      <visual>
        <geometry><cylinder radius="0.015" length="0.04"/></geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.015" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.0000056875" ixy="0" ixz="0"
                 iyy="0.0000056875" iyz="0" izz="0.000003375"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}_roller_${index}">
      <mu1>1.0</mu1><mu2>1.0</mu2>
      <kp>100000</kp><kd>10</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix x y handedness">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_r - chassis_z}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="0.045" length="0.025"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.045" length="0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.14"/>
        <inertia ixx="0.0000781667" ixy="0" ixz="0"
                 iyy="0.0000781667" iyz="0" izz="0.00014175"/>
      </inertial>
    </link>
    <xacro:roller prefix="${prefix}" index="0" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="1" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="2" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="3" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="4" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="5" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="6" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="7" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="8" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="9" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="10" handedness="${handedness}"/>
    <xacro:roller prefix="${prefix}" index="11" handedness="${handedness}"/>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x="${wheel_base_x}" y="${wheel_track_y}" handedness="1"/>
  <xacro:wheel prefix="front_right" x="${wheel_base_x}" y="${-wheel_track_y}" handedness="-1"/>
  <xacro:wheel prefix="rear_left" x="${-wheel_base_x}" y="${wheel_track_y}" handedness="-1"/>
  <xacro:wheel prefix="rear_right" x="${-wheel_base_x}" y="${-wheel_track_y}" handedness="1"/>

  <!-- ============ 虚拟激光雷达 ============ -->
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>


  <xacro:include filename="$(find omove_description)/urdf/gazebo.urdf.xacro"/>
    <!-- ============ ros2_control配置 ============ -->
  <!-- Passive joints expose feedback only; no motor command interfaces. -->
  <xacro:macro name="roller_feedback" params="prefix index">
    <joint name="${prefix}_roller_${index}_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="wheel_feedback" params="prefix">
    <xacro:roller_feedback prefix="${prefix}" index="0"/>
    <xacro:roller_feedback prefix="${prefix}" index="1"/>
    <xacro:roller_feedback prefix="${prefix}" index="2"/>
    <xacro:roller_feedback prefix="${prefix}" index="3"/>
    <xacro:roller_feedback prefix="${prefix}" index="4"/>
    <xacro:roller_feedback prefix="${prefix}" index="5"/>
    <xacro:roller_feedback prefix="${prefix}" index="6"/>
    <xacro:roller_feedback prefix="${prefix}" index="7"/>
    <xacro:roller_feedback prefix="${prefix}" index="8"/>
    <xacro:roller_feedback prefix="${prefix}" index="9"/>
    <xacro:roller_feedback prefix="${prefix}" index="10"/>
    <xacro:roller_feedback prefix="${prefix}" index="11"/>
  </xacro:macro>
  <ros2_control name="OmoveSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="$(arg wheel_control_mode)"/>
      <param name="vel_kp">0.5</param><param name="vel_ki">0.5</param><param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">2.0</param><param name="vel_min_integral_error">-2.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="$(arg wheel_control_mode)"/>
      <param name="vel_kp">0.5</param><param name="vel_ki">0.5</param><param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">2.0</param><param name="vel_min_integral_error">-2.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="$(arg wheel_control_mode)"/>
      <param name="vel_kp">0.5</param><param name="vel_ki">0.5</param><param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">2.0</param><param name="vel_min_integral_error">-2.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="$(arg wheel_control_mode)"/>
      <param name="vel_kp">0.5</param><param name="vel_ki">0.5</param><param name="vel_kd">0.0</param>
      <param name="vel_max_integral_error">2.0</param><param name="vel_min_integral_error">-2.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <xacro:wheel_feedback prefix="front_left"/>
    <xacro:wheel_feedback prefix="front_right"/>
    <xacro:wheel_feedback prefix="rear_left"/>
    <xacro:wheel_feedback prefix="rear_right"/>
  </ros2_control>

  
</robot>

